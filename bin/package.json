{
  "name": "Aharthern",
  "version": "1.0.0",
  "description": "Application .exe du site Aharthern",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "Bilal Boudjemline",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^26.0.15"
  },
  "build": {
    "productName": "Aharthern - ACNH",
    "appId": "com.Aharthern.app",
    "win": {
      "target": "nsis",
      "icon": "build/favico.ico",
      "artifactName": "Aharthern.setup.${version}.${ext}"
    },
    "files": [
      "main.js",
      "build/**"
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "path": "^0.12.7"
  }
}